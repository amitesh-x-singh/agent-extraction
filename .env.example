# Copy to .env and fill in. .env is gitignored and must stay that way.

# Required. Used for the agent's chat calls and for the hosted web_search tool.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required. fetch_page's middle tier: a headless-browser fetch for pages that a plain GET
# cannot retrieve (bot-blocked or JS-rendered). Without it the pipeline still runs, but every
# such page escalates to the ~10x more expensive paid search fallback, so the CLI refuses to
# start rather than let a batch quietly cost several times what it should.
# https://app.scrapingbee.com/account/manage
SCRAPINGBEE_API_KEY=

# Optional. Contact address advertised in the User-Agent on outbound page fetches, so site
# operators can reach whoever is crawling them. Left empty, the User-Agent points at this
# repository instead.
SEARCH_CONTACT_EMAIL=
